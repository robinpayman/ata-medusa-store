# Medusa Backend Configuration
# Replace with your actual Medusa backend URL
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_YOUR_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Region and URL Configuration
NEXT_PUBLIC_DEFAULT_REGION=dk
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe Publishable Key (optional, only if using Stripe for payments)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 Bucket Hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 Bucket Pathname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node Environment
NODE_ENV=development
